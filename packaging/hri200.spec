# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for the bridge and the control panel.

Two programs come out of the same source tree:

    hri200-bridge     the CAT bridge, console, one file
    hri200-gui        the control panel, windowed

    python3 packaging/make_icons.py
    python -m PyInstaller packaging/hri200.spec --noconfirm

How the control panel is packaged differs per platform, because the
platforms disagree about what an application is:

    Windows   a single windowed .exe, double-clickable, no install
    Linux     a single ELF binary, plus a .desktop file for the menu
    macOS     a .app bundle, which is a directory by definition

The bridge is one file everywhere: it is the thing you copy onto the
machine that has the radio plugged in, and one file cannot arrive with
half its libraries missing.

Icons are generated by packaging/make_icons.py; the build works without
them and simply looks anonymous if they are absent.
"""

import os
import sys

ROOT = os.path.abspath(os.path.join(SPECPATH, ".."))
sys.path.insert(0, ROOT)

ICON_DIR = os.path.join(SPECPATH, "icons")
ICON_ICO = os.path.join(ICON_DIR, "hri200.ico")
ICON_ICNS = os.path.join(ICON_DIR, "hri200.icns")


def icon_for(platform):
    if platform == "win32" and os.path.exists(ICON_ICO):
        return ICON_ICO
    if platform == "darwin" and os.path.exists(ICON_ICNS):
        return ICON_ICNS
    return None


HIDDEN = [
    "serial",
    "serial.tools",
    "serial.tools.list_ports",
    "hri200_radio",
]

EXCLUDES = [
    # Nothing here needs a scientific stack; leaving these out keeps the
    # executables at a few megabytes instead of a few hundred.
    "numpy", "scipy", "pandas", "matplotlib", "PIL",
    "pytest", "setuptools", "pip",
    "test", "unittest",
    "pydoc_data", "lib2to3", "distutils",
]


def analyse(script):
    return Analysis(
        [os.path.join(ROOT, script)],
        pathex=[ROOT],
        hiddenimports=HIDDEN,
        excludes=EXCLUDES,
        noarchive=False,
    )


# -- the bridge: one file, console, everywhere -------------------------
bridge = analyse("hri200_cat.py")
bridge_pyz = PYZ(bridge.pure, bridge.zipped_data)
bridge_exe = EXE(
    bridge_pyz,
    bridge.scripts,
    bridge.binaries,
    bridge.datas,
    [],
    name="hri200-bridge",
    debug=False,
    strip=False,
    upx=False,
    console=True,
    disable_windowed_traceback=False,
    icon=icon_for(sys.platform),
)

# -- the control panel -------------------------------------------------
gui = analyse("hri200_gui.py")
gui_pyz = PYZ(gui.pure, gui.zipped_data)

# macOS needs a directory so the .app can wrap it; the other two need a
# single file the user can double-click without a folder appearing.
GUI_ONEDIR = sys.platform == "darwin"

gui_exe = EXE(
    gui_pyz,
    gui.scripts,
    [] if GUI_ONEDIR else gui.binaries,
    [] if GUI_ONEDIR else gui.datas,
    exclude_binaries=GUI_ONEDIR,
    name="hri200-gui",
    debug=False,
    strip=False,
    upx=False,
    console=False,
    disable_windowed_traceback=False,
    icon=icon_for(sys.platform),
)

if GUI_ONEDIR:
    gui_coll = COLLECT(
        gui_exe,
        gui.binaries,
        gui.datas,
        strip=False,
        upx=False,
        name="hri200-gui",
    )

if sys.platform == "darwin":
    gui_app = BUNDLE(
        gui_coll,
        name="HRI-200 bridge.app",
        icon=ICON_ICNS if os.path.exists(ICON_ICNS) else None,
        bundle_identifier="org.yaesu.hri200.bridge",
        info_plist={
            "CFBundleName": "HRI-200 bridge",
            "CFBundleDisplayName": "HRI-200 bridge",
            "CFBundleShortVersionString": "1.0",
            "NSHighResolutionCapable": True,
            "LSMinimumSystemVersion": "10.13",
            "NSHumanReadableCopyright": "",
        },
    )
